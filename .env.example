# GitHub token with repo read access (used to fetch issues + clone repos)
GITHUB_TOKEN=ghp_your_token_here

# Groq API (OpenAI-compatible chat completions)
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_A=openai/gpt-oss-120b
GROQ_MODEL_B=groq/compound
GROQ_SKIP_TEMPERATURE=groq/compound

# Retrieval configuration
RETRIEVAL_TOP_K=8
RETRIEVAL_MODE=hybrid
RETRIEVAL_LEXICAL_WEIGHT=0.65
RETRIEVAL_SEMANTIC_WEIGHT=0.35

# Docker sandbox configuration
DOCKER_IMAGE=python:3.11-slim
DOCKER_TIMEOUT=120
DOCKER_TEST_COMMAND=python -m pytest -q
DOCKER_MEMORY=512m
DOCKER_CPUS=1.0
DOCKER_NETWORK_DISABLED=false
